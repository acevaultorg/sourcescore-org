# SourceScore — environment variable example
# Copy to .env.local for dev or set in Cloudflare Pages env for production.

# Plausible (privacy-first analytics) — set to enable, leave unset to skip.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=sourcescore.org

# Cloudflare Web Analytics — set the beacon token to enable.
# Get token from: dash.cloudflare.com → Web Analytics → Your site → Snippet
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# IndexNow — for postdeploy ping to Bing + Yandex + Seznam.
# A key has been generated and stored at:
#   public/<key>.txt   (the public verification file; required for trust)
#   .indexnow-key.txt  (local snapshot; gitignored)
# To activate `npm run deploy` IndexNow pings, copy the key from
# .indexnow-key.txt or just `cat public/*.txt` and set this:
INDEXNOW_KEY=
